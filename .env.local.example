# ----- Core -----
MONGODB_URI=mongodb://localhost:27017/nexustrade
NEXTAUTH_SECRET=replace-with-long-random-string
NEXTAUTH_URL=http://localhost:3000

# Single-user credentials (for NextAuth credentials provider)
# Use ADMIN_PASSWORD_HASH in production (bcrypt), fall back to plain ADMIN_PASSWORD in dev.
# Generate a hash with:  npm run hash-password -- "my-secret-password"
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_PASSWORD_HASH=

# Encryption key for stored API secrets (32 chars)
ENCRYPTION_KEY=change_me_to_a_random_32_char_key

# ----- Binance (also settable from UI) -----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true

# ----- AI (also settable from UI) -----
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# ----- Notifications (optional) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Workers -----
# Set to "true" to auto-start cron workers when Next.js boots (dev only)
AUTOSTART_WORKERS=false
