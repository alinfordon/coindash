# ----- Core -----
MONGODB_URI=mongodb://localhost:27017/nexustrade
NEXTAUTH_SECRET=replace-with-long-random-string
NEXTAUTH_URL=http://localhost:3000

# First admin (created in MongoDB on first login if no users exist)
# ADMIN_EMAIL should be a real email you use to sign in.
# Use ADMIN_PASSWORD_HASH in production (bcrypt), or plain ADMIN_PASSWORD in dev.
# Generate a hash with:  npm run hash-password -- "my-secret-password"
ADMIN_EMAIL=admin@example.com
ADMIN_NAME=Administrator
ADMIN_USERNAME=admin
ADMIN_PASSWORD=admin
ADMIN_PASSWORD_HASH=

# Encryption key for stored API secrets (32 chars)
ENCRYPTION_KEY=change_me_to_a_random_32_char_key

# ----- Binance (also settable from UI) -----
BINANCE_API_KEY=
BINANCE_API_SECRET=
BINANCE_TESTNET=true
# IP whitelist — trimis în emailul de invitație /admin
BINANCE_API_WHITELIST_IP=82.78.230.206

# ----- VIP donation (upgrade User → VIP via USDC) -----
# Verificare automată în istoricul depozitelor contului Binance al administratorului (live).
VIP_DONATION_ENABLED=true
VIP_DONATION_USDC_AMOUNT=5
VIP_DONATION_NETWORK=BSC
# Chei API live ale administratorului (permisiune „Enable Reading” + depozite).
# Dacă lipsesc, se folosesc BINANCE_API_KEY / BINANCE_API_SECRET de mai sus.
VIP_DONATION_BINANCE_API_KEY=
VIP_DONATION_BINANCE_API_SECRET=
# Opțional: adresă USDC fixă (sari peste fetch din API)
VIP_USDC_DEPOSIT_ADDRESS=

# ----- AI (also settable from UI) -----
AI_PROVIDER=claude
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5
GOOGLE_API_KEY=
GOOGLE_MODEL=gemini-2.0-flash
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-chat
DEEPSEEK_BASE_URL=https://api.deepseek.com
OLLAMA_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2

# Email (Gmail + App Password) — invitații utilizatori noi din /admin
# https://myaccount.google.com/apppasswords
EMAIL_USER=your@gmail.com
EMAIL_PASS=your-gmail-app-password
EMAIL_FROM=your@gmail.com

# ----- Notifications (optional) -----
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ----- Workers -----
# Set to "true" to auto-start cron workers when Next.js boots (dev only)
AUTOSTART_WORKERS=false
